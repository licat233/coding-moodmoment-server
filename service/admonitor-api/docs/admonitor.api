info(
	title: "广告监测服务API"
	author: "licat"
	email: "1697470538@qq.com"
	version: "v1"
)

type Request {
	Id int64 `json:"id"`
}

type Response {
	Success bool        `json:"success"`
	Message string      `json:"message"`
	Data    interface{} `json:"data"`
}

//获取日期范围内的广告监测数据
type GetStatisticsRequest {
	Channel   string `json:"channel"`   //渠道
	Account   string `json:"account"`   //账号
	StartDate string `json:"startDate"` //开始日期
	EndDate   string `json:"endDate"`   //结束日期
}

type DownloadReq {
	File string `path:"file"`
}

@server(
	prefix: /admonitor
)
service admonitor-api {
	@doc(
		summary: "获取日期范围内的广告监测数据",
	)
	@handler GetStatisticsHandler
	post /statistics (GetStatisticsRequest) returns (Response)
	
	@doc(
		summary: 获取监控系统状态
	)
	@handler GetStatusHandler
	post /status returns (Response)
	
	@doc(
		summary: 静态文件服务
	)
	@handler DownloadHandler
	get /download/:file(DownloadReq)
}