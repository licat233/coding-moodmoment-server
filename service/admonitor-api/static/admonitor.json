{
  "swagger": "2.0",
  "info": {
    "title": "广告监测服务API",
    "version": "v1"
  },
  "host": "wx.api.catli.net",
  "basePath": "/",
  "schemes": [
    "http",
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/download/{file}": {
      "get": {
        "summary": "静态文件服务",
        "operationId": "DownloadHandler",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {}
          }
        },
        "parameters": [
          {
            "name": "file",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "admonitor-api"
        ]
      }
    },
    "/statistics": {
      "post": {
        "summary": "获取日期范围内的广告监测数据",
        "operationId": "GetStatisticsHandler",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/Response"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/GetStatisticsRequest"
            }
          }
        ],
        "tags": [
          "admonitor-api"
        ]
      }
    },
    "/status": {
      "post": {
        "summary": "获取监控系统状态",
        "operationId": "GetStatusHandler",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/Response"
            }
          }
        },
        "tags": [
          "admonitor-api"
        ]
      }
    }
  },
  "definitions": {
    "DownloadReq": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        }
      },
      "title": "DownloadReq",
      "required": [
        "file"
      ]
    },
    "GetStatisticsRequest": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "description": "渠道"
        },
        "account": {
          "type": "string",
          "description": "账号"
        },
        "startDate": {
          "type": "string",
          "description": "开始日期"
        },
        "endDate": {
          "type": "string",
          "description": "结束日期"
        }
      },
      "title": "GetStatisticsRequest",
      "required": [
        "channel",
        "account",
        "startDate",
        "endDate"
      ]
    },
    "Request": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64"
        }
      },
      "title": "Request",
      "required": [
        "id"
      ]
    },
    "Response": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "format": "boolean"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      },
      "title": "Response",
      "required": [
        "success",
        "message",
        "data"
      ]
    }
  },
  "securityDefinitions": {
    "apiKey": {
      "type": "apiKey",
      "description": "Enter JWT Bearer token **_only_**",
      "name": "Authorization",
      "in": "header"
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ]
}
